{
  "id": "bilibili",
  "apiVersion": 1,
  "version": "0.2.0",
  "name": "B 站",
  "description": "搜索与阅读视频简介、可用字幕和评论，保留续读进度；使用已登录账号原生收藏／取消收藏。",
  "defaultEnabled": false,
  "defaults": {
    "timeoutMs": 20000,
    "requestGapMs": 1500,
    "requestsPerDay": 120,
    "cooldownMs": 900000,
    "cookieEnv": "BILIBILI_COOKIE",
    "favoriteFolderId": 0
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "title": "请求超时（毫秒）"
      },
      "requestGapMs": {
        "type": "integer",
        "minimum": 500,
        "maximum": 60000,
        "title": "请求间隔（毫秒）"
      },
      "requestsPerDay": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "title": "每日请求上限（UTC）"
      },
      "cooldownMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "title": "平台限流后的冷却时间（毫秒）"
      },
      "cookieEnv": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "credential": true,
        "title": "B 站 Cookie 凭据名称",
        "description": "凭据值在模型页单独填写。未登录可尝试公开内容，字幕等接口可能要求登录。"
      },
      "favoriteFolderId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "title": "B 站收藏夹 ID",
        "description": "0 表示唯一名为“默认收藏夹”的收藏夹；也可指定自己账号的收藏夹 ID。keep 只修改这个收藏夹，不影响其他收藏夹。原生收藏需要有效登录 Cookie。"
      }
    },
    "required": [
      "timeoutMs",
      "requestGapMs",
      "requestsPerDay",
      "cooldownMs",
      "cookieEnv",
      "favoriteFolderId"
    ],
    "additionalProperties": false
  },
  "contextVersion": "2"
}
