{
  "name": "qiuyue-digital-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk.d.ts",
      "default": "./dist/plugin-sdk.js"
    }
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit && tsc -p packages/tsconfig.json",
    "sync:snowluma": "node scripts/sync-snowluma-catalog.mjs",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build:plugins": "node packages/build.mjs",
    "sync:telegram": "node scripts/sync-telegram-catalog.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@snowluma/sdk": "2.3.4",
    "htm": "3.1.1",
    "preact": "10.28.2",
    "sharp": "0.35.5",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@grammyjs/types": "5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-json-schema": "0.68.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "typescript-json-schema": {
      "glob": "14.0.3"
    }
  }
}
